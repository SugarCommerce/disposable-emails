{
  "name": "sugarcommerce/disposable-emails",
  "description": "Tell whether an email address belongs to a disposable provider -- mailinator, guerrillamail and ten thousand like them -- from a list kept current, with your own blocked and allowed domains alongside it.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/sugarcommerce/disposable-emails",
  "authors": [
    {
      "name": "David Sherlock",
      "homepage": "https://arraypress.com/"
    }
  ],
  "require": {
    "php": ">=8.3"
  },
  "suggest": {
    "ext-intl": "Looks up a Unicode domain -- and a full-width one -- as its xn-- form, so it cannot slip past the list."
  },
  "autoload": {
    "psr-4": {
      "SugarCommerce\\DisposableEmails\\": "src/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": false
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "support": {
    "issues": "https://github.com/sugarcommerce/disposable-emails/issues",
    "source": "https://github.com/sugarcommerce/disposable-emails"
  },
  "keywords": [
    "wordpress",
    "email",
    "disposable",
    "blocklist",
    "spam",
    "signup"
  ],
  "require-dev": {
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpunit/phpunit": "^12.0",
    "squizlabs/php_codesniffer": "^3.13.5",
    "wp-coding-standards/wpcs": "^3.4"
  },
  "autoload-dev": {
    "psr-4": {
      "SugarCommerce\\DisposableEmails\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs",
    "format": "phpcbf --standard=phpcs-format.xml.dist",
    "format:check": "phpcs --standard=phpcs-format.xml.dist",
    "refresh": "@php bin/refresh.php"
  }
}
